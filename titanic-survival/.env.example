# Copy to .env and fill in. In AWS these are set as systemd/Beanstalk env vars.

# Flask
SECRET_KEY=replace-with-a-long-random-string

# Sign-in account seeded on first run
APP_USERNAME=admin
APP_PASSWORD=change-me

# Tier 3 — the deployed model
AWS_REGION=us-east-1
SAGEMAKER_ENDPOINT_NAME=titanic-endpoint

# Data tier: SQLite locally; a Postgres URL for RDS in production
# DATABASE_URL=postgresql+psycopg://user:pass@my-rds-endpoint:5432/titanic

# Set to 1 to score locally without AWS (handy for a demo)
MOCK_PREDICTIONS=0
